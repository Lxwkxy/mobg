POSTGRES_DB=mobg_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433
POSTGRES_HOST=127.0.0.1
PORT=5000
CORS_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:5000
# Generate a random value of at least 32 characters; never commit the actual .env.
BETTER_AUTH_SECRET=change_me_generate_a_random_secret
# Real mail: use your SMTP provider settings and a verified sender.
# Local capture: set AUTH_MAIL_MODE=mailpit and start compose.mail.yml.
AUTH_MAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# MAILPIT_SMTP_PORT=1025
